# ===========================================
# PMS Backend - Environment Variables
# ===========================================
# Copy this file to .env.development.local:
#   cp .env.example .env.development.local

# Application
NODE_ENV=dev
PORT=3000

# Database
DB_HOST=db
DB_PORT=3306
DB_USERNAME=pms_user
DB_PASSWORD=secure_password_123
DB_NAME=pms_backend

# Docker - Port mapping (host:container)
DB_LOCAL_PORT=3306
DB_DOCKER_PORT=3306
APP_LOCAL_PORT=3000
APP_DOCKER_PORT=3000
MYSQL_ROOT_PASSWORD=root_password_123

# JWT
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_DURATION=24h

# Firebase Admin (optional): single-line JSON from Firebase Console → Project settings → Service accounts → Generate new private key.
# Used to mint custom tokens so the web app can sign in to Firebase Auth before Storage uploads (`request.auth != null` in rules).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# Firebase Storage bucket (e.g. your-project.appspot.com) — needed for signed URL generation in Phase 2.
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# Admin credentials (used by seeder)
ADMIN_EMAIL=admin@pms.edu.co
ADMIN_PASSWORD=Admin1234!

# Seeder (set to "true" to auto-seed on app start in dev)
SEED_ON_START=true

# OpenAI (Academic Assistant — Phase 1 chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI Service (Academic Assistant — Phase 2 RAG)
PMS_AI_SERVICE_BASE_URL=http://host.docker.internal:8100
PMS_AI_SERVICE_SECRET=dev-shared-secret-change-in-prod
